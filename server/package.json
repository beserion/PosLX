{
    "name": "poslx-server",
    "version": "1.0.0",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "dev:electron": "electron .",
        "prebuild:exe": "npm --prefix ../client run build && shx rm -rf public && shx cp -r ../client/dist public",
        "build:exe": "electron-builder --win"
    },
    "build": {
        "appId": "com.poslx.app",
        "productName": "PosLX",
        "asar": false,
        "directories": {
            "output": "dist_app"
        },
        "files": [
            "**/*",
            "!dist_app{,/**/*}",
            "!{.env,.gitignore}",
            "!*.log",
            "!*.txt",
            "!check_db.mjs",
            "!clear_db.mjs",
            "!db_test_fk.js",
            "!seed_data.mjs",
            "!test-*.js",
            "!test_api.mjs",
            "node_modules/**/*",
            "public/**/*"
        ],
        "win": {
            "target": "nsis"
        }
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "mssql": "^12.2.0",
        "node-thermal-printer": "^4.6.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "electron": "^34.3.0",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.25.0",
        "shx": "^0.4.0"
    }
}